    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ─── Collect all jobs from all 3 API responses ───────────────────────────\nconst allJobs = [];\nfor (const item of $input.all()) {\n  const jobs = item.json.data || [];\n  allJobs.push(...jobs);\n}\n\n// ─── Deduplication: persist seen job IDs across workflow runs ────────────\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.seenJobIds) staticData.seenJobIds = [];\n\n// ─── Known H1B sponsor companies ─────────────────────────────────────────\nconst sponsorCompanies = [\n  'infosys', 'tcs', 'tata consultancy', 'wipro', 'cognizant', 'hcl',\n  'capgemini', 'deloitte', 'accenture', 'ibm', 'sap ', 'sap,', 'sap america',\n  'pwc', 'kpmg', 'ernst & young', 'ey ', 'mindtree', 'lti ', 'larsen',\n  'hexaware', 'mphasis', 'tech mahindra', 'persistent systems',\n  'oracle', 'microsoft', 'google', 'amazon', 'salesforce', 'sap labs'\n];\n\n// Keywords in job description that indicate sponsorship\nconst h1bKeywords = [\n  'h1b', 'h-1b', 'visa sponsor', 'will sponsor', 'sponsorship',\n  'work authorization', 'opt accepted', 'stem opt', 'ead accepted'\n];\n\nfunction isH1BFriendly(job) {\n  const company = (job.employer_name || '').toLowerCase();\n  const desc   = (job.job_description || '').toLowerCase();\n  return (\n    sponsorCompanies.some(s => company.includes(s)) ||\n    h1bKeywords.some(k => desc.includes(k))\n  );\n}\n\n// ─── Filter: new + H1B friendly + dedupe within this batch ───────────────\nconst seenInBatch = new Set();\nconst newJobs = allJobs.filter(job => {\n  if (!job.job_id)                              return false;\n  if (staticData.seenJobIds.includes(job.job_id)) return false;\n  if (seenInBatch.has(job.job_id))              return false;\n  seenInBatch.add(job.job_id);\n  return isH1BFriendly(job);\n});\n\n// ─── Persist seen IDs (capped at 3000 to avoid memory bloat) ─────────────\nstaticData.seenJobIds = [\n  ...staticData.seenJobIds,\n  ...newJobs.map(j => j.job_id)\n].slice(-3000);\n\n// ─── No new jobs: return flag and stop ───────────────────────────────────\nif (newJobs.length === 0) {\n  return [{ json: { hasNewJobs: false, count: 0 } }];\n}\n\n// ─── Format each new job for Telegram ────────────────────────────────────\nreturn newJobs.map(job => {\n  const loc = job.job_is_remote\n    ? '🌐 Remote'\n    : `📍 ${[job.job_city, job.job_state].filter(Boolean).join(', ') || 'USA'}`;\n\n  const salaryLine = (job.job_min_salary && job.job_max_salary)\n    ? `💰 $${Math.round(job.job_min_salary / 1000)}K–$${Math.round(job.job_max_salary / 1000)}K/yr\\n`\n    : '';\n\n  const posted = job.job_posted_at_datetime_utc\n    ? new Date(job.job_posted_at_datetime_utc)\n        .toLocaleDateString('en-US', { month: 'short', day: 'numeric' })\n    : 'Today';\n\n  const applyLink = job.job_apply_link || 'https://www.linkedin.com/jobs/';\n\n  const message =\n    `🔔 *New SAP Job Alert*\\n\\n` +\n    `💼 *${job.job_title}*\\n` +\n    `🏢 ${job.employer_name}\\n` +\n    `${loc}\\n` +\n    `${salaryLine}` +\n    `📅 Posted: ${posted}\\n\\n` +\n    `🔗 [Apply Now](${applyLink})`;\n\n  return {\n    json: {\n      hasNewJobs: true,\n      message,\n      title: job.job_title,\n      company: job.employer_name,\n      location: loc\n    }\n  };\n});"
      },
